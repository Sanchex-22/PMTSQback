// prisma/schema.prisma

datasource db {
  provider = "postgresql" // o "mysql", "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SALES
  CLIENT
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password         String
  name             String?
  role             Role      @default(CLIENT)
  createdAt        DateTime  @default(now())
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  quotes           Quote[]
}

model Course {
  id                       Int           @id @default(autoincrement())
  name                     String        @unique
  abbr                     String?
  price_panamanian         Float?
  price_panamanian_renewal Float?
  price_foreign            Float?
  price_foreign_renewal    Float?
  imo_no                   String?
  // CAMBIO: Ahora se relaciona con la tabla intermedia QuoteCourse
  deletedAt                DateTime? 
  quoteItems               QuoteCourse[]
}

enum QuoteStatus {
  PENDING
  APPROVED
  EXPIRED
  REJECTED
}

// NUEVO MODELO: La tabla intermedia para la relación muchos a muchos
model QuoteCourse {
  id          Int    @id @default(autoincrement())
  quoteId     Int
  quote       Quote  @relation(fields: [quoteId], references: [id])
  courseId    Int
  course      Course @relation(fields: [courseId], references: [id])
  type        String // "new" o "renewal" para saber de qué tipo era
  basePrice   Float  // El precio base calculado para este curso en la cotización
  surcharge   Float  // El recargo aplicado a este curso en la cotización

  @@unique([quoteId, courseId, type]) // Evita duplicados en la misma cotización
}

model Quote {
  id          Int         @id @default(autoincrement())
  createdAt   DateTime    @default(now())
  quotedPrice Float
  status      QuoteStatus @default(PENDING)
  expiresAt   DateTime
  government  String?     // Opcional: para guardar qué tipo de gobierno se usó
  userId      Int
  user        User        @relation(fields: [userId], references: [id])

  // CAMBIO: Se elimina la relación directa a un solo curso
  // courseId    Int
  // course      Course      @relation(fields: [courseId], references: [id])

  // CAMBIO: Ahora una cotización tiene una lista de items de curso
  courses     QuoteCourse[]
}

model Instructor {
  id   Int    @id @default(autoincrement())
  name String @unique
}


model Evaluation {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  courseName            String
  instructorName        String
  personnelAttention    String
  questionsReplied      String
  certificateDelivery   String
  websiteInformation    String
  facilities            String
  scheduleAppropriate   String
  studyMaterial         String
  trainingQuality       String
  provideFeedback       String
  demonstrateExamples   String
  encourageParticipation String
  communicateClearly    String
  demonstrateKnowledge  String
}