// prisma/schema.prisma
datasource db {
  provider = "postgresql" // o "mysql", "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN  // Administrador con todos los permisos
  SALES  // Vendedor que puede crear cotizaciones
  CLIENT // Cliente que puede solicitar cotizaciones
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  quotes    Quote[]
}

model Course {
  id                     Int      @id @default(autoincrement())
  name                   String   @unique
  abbr                   String?
  price_panamanian       Float?
  price_panamanian_renewal Float?
  price_foreign          Float?
  price_foreign_renewal  Float?
  imo_no                 String?
  quotes                 Quote[]
}

enum QuoteStatus {
  PENDING
  APPROVED
  EXPIRED
  REJECTED
}

model Quote {
  id          Int         @id @default(autoincrement())
  createdAt   DateTime    @default(now())
  quotedPrice Float
  status      QuoteStatus @default(PENDING)
  userId      Int
  user        User        @relation(fields: [userId], references: [id])
  courseId    Int
  course      Course      @relation(fields: [courseId], references: [id])
  expiresAt   DateTime    // ¡NUEVO CAMPO! Para la validez de 45 días
}
model Instructor {
  id   Int    @id @default(autoincrement())
  name String @unique
}


model Evaluation {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  courseName            String
  instructorName        String
  personnelAttention    String
  questionsReplied      String
  certificateDelivery   String
  websiteInformation    String
  facilities            String
  scheduleAppropriate   String
  studyMaterial         String
  trainingQuality       String
  provideFeedback       String
  demonstrateExamples   String
  encourageParticipation String
  communicateClearly    String
  demonstrateKnowledge  String
}